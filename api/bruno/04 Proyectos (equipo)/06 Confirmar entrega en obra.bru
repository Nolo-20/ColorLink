meta {
  name: Confirmar entrega en obra
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/projects/{{proyectoId}}/delivery
  body: json
  auth: none
}

headers {
  Cookie: session={{session}}
}

body:json {
  {
    "recibidoPor": "Carlos Gomez",
    "documentoRecibe": "1234567"
  }
}

tests {
  test("responde 200 y success", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
  test("el proyecto queda entregado", function() { expect(res.getBody().project.estadoPipeline).to.equal('entregado'); });
}
