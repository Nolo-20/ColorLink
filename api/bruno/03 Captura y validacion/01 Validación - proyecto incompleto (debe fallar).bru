meta {
  name: Validación - proyecto incompleto (debe fallar)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/projects
  body: json
  auth: none
}

headers {
  Cookie: session={{session}}
}

body:json {
  {
    "nombreProyecto": "Sin datos"
  }
}

tests {
  test("completitud: rechaza con 400 y lista los campos", function() {
    expect(res.getStatus()).to.equal(400);
    const e = res.getBody().errores;
    expect(e).to.have.property('tipoProyecto');
    expect(e).to.have.property('area');
    expect(e).to.have.property('fechaRequerida');
    expect(e).to.have.property('consentimientoDatos');
  });
}
