meta {
  name: Catálogo de la tienda
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/catalog
  body: none
  auth: none
}

tests {
  test("responde 200 y success", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
  test("trae productos con presentaciones y stock", function() {
    const p = res.getBody().products[0];
    expect(p).to.have.property('sizes');
    expect(p.sizes[0]).to.have.property('stock');
  });
}
